<?xml version="1.0" encoding="UTF-8"?>
<!--
  ===========================================================================
  USER-MAPPING GUACAMOLE — EXEMPLE (PLAINTEXT)
  ===========================================================================
  NE PAS COMMITTER CE FICHIER TEL QUEL AVEC DE VRAIS MOTS DE PASSE.

  Procédure (génère secrets/user-mapping.xml.age, chiffré par sops/age) :
      cp secrets/user-mapping.xml.example secrets/user-mapping.xml
      <éditer : vrais comptes + vrais mots de passe + IPs de connexion>
      sops -e -i secrets/user-mapping.xml          # chiffre en place
      mv secrets/user-mapping.xml secrets/user-mapping.xml.age

  NB : le mot de passe Windows utilisé par Guacamole = le mot de passe
  `administrator` (same que ansible_winrm, sourcé depuis le vault existant,
  jamais saisi ici en clair dans git).

  NB réseau : les `hostname` ci-dessous sont les IPs de gestion
  (10.0.1.100 = Black, 10.0.2.100 = Orange). La joignabilité RDP depuis la
  VM Guacamole (vmbr0 uniquement) est traitée dans docs/architecture.md et
  docs/DEPLOYMENT.md : soit par NIC de gestion sur vmbr0, soit par
  redirection contrôlée (playbook gated 20-guacamole-reachability.yml).

  NB XML : échapper les caractères spéciaux des mots de passe
  (& -> &amp;, < -> &lt;, > -> &gt;, " -> &quot;).
-->
<user-mapping>
    <authorize
        username="guacadmin"
        password="CHANGEZ_MOI_guacamole_user_password"
    >
        <connection name="Black — Windows 11 (RDP)">
            <protocol>rdp</protocol>
            <param name="hostname">10.0.1.100</param>
            <param name="port">3389</param>
            <param name="username">administrator</param>
            <param name="password">CHANGEZ_MOI_WINDOWS_BLACK_PASSWORD</param>
            <param name="security">any</param>
            <param name="ignore-cert">true</param>
            <param name="enable-wallpaper">true</param>
            <param name="resize-method">display-update</param>
            <param name="disable-audio">true</param>
        </connection>

        <connection name="Orange — Windows 11 (RDP)">
            <protocol>rdp</protocol>
            <param name="hostname">10.0.2.100</param>
            <param name="port">3389</param>
            <param name="username">administrator</param>
            <param name="password">CHANGEZ_MOI_WINDOWS_ORANGE_PASSWORD</param>
            <param name="security">any</param>
            <param name="ignore-cert">true</param>
            <param name="enable-wallpaper">true</param>
            <param name="resize-method">display-update</param>
            <param name="disable-audio">true</param>
        </connection>
    </authorize>
</user-mapping>
