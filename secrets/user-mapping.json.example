{
  "user-mapping.xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!--\n  USER-MAPPING GUACAMOLE — EXEMPLE\n  Compte de test : guacadmin / CHANGEZ_MOI\n  Remplacer les mots de passe et IP par les vrais, puis chiffrer :\n    sops -e --input-type json --output-type json secrets/user-mapping.json > secrets/user-mapping.json.age\n-->\n<user-mapping>\n    <authorize\n        username=\"guacadmin\"\n        password=\"CHANGEZ_MOI\"\n    >\n        <connection name=\"Exemple — Windows 11 (RDP)\">\n            <protocol>rdp</protocol>\n            <param name=\"hostname\">10.0.0.10</param>\n            <param name=\"port\">3389</param>\n            <param name=\"username\">administrator</param>\n            <param name=\"password\">CHANGEZ_MOI</param>\n            <param name=\"security\">any</param>\n            <param name=\"ignore-cert\">true</param>\n            <param name=\"enable-wallpaper\">true</param>\n            <param name=\"resize-method\">display-update</param>\n            <param name=\"disable-audio\">true</param>\n        </connection>\n    </authorize>\n</user-mapping>"
}
